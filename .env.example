# ---- Nexus Dashboard connection (required) ----
# Base URL of the ND cluster (no trailing slash).
ND_HOST=https://nd.example.com
# Authentication domain/realm (default: local). e.g. local, LDAP, RADIUS, TACACS, OIDC
ND_DOMAIN=local
ND_USERNAME=admin
# Prefer an OS keychain over a plaintext file. Set here ONLY for local dev.
ND_PASSWORD=

# ---- TLS / transport (optional) ----
# ND often uses a self-signed cert. Set to false to skip verification (dev only).
ND_VERIFY_TLS=true
# Per-request timeout in seconds.
ND_TIMEOUT=30

# ---- Output shaping (optional) ----
# Hard cap on characters returned by any tool (protects the model's context).
ND_MAX_OUTPUT_CHARS=8000

# ---- Service base paths (optional; defaults match ND 4.2.1 unified API) ----
# Override only if your deployment mounts the services differently.
ND_LOGIN_PATH=/api/v1/infra/login
ND_MANAGE_BASE=/api/v1/manage
ND_ANALYZE_BASE=/api/v1/analyze
ND_INFRA_BASE=/api/v1/infra
ND_ONE_MANAGE_BASE=/api/v1/oneManage
